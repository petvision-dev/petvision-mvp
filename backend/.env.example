# PostgreSQL Database
DATABASE_URL=postgres://petvision:your_password@petvision-db:5432/petvision


# Application
NODE_ENV=production
PORT=3000


# Security
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production


# CORS
ALLOWED_ORIGINS=https://yourdomain.com,https://petvision.vercel.app


# Akash Network Deployment Settings
# These will be replaced during deployment
# DATABASE_PASSWORD: Will be set in Akash deployment
# JWT_SECRET: Will be set in Akash deployment
